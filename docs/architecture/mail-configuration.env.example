# Reference only: this documentation file is NOT loaded as an environment file.
# Copy required settings into .env.local or the intended Vercel environment.
# Never commit filled credentials or connect public Preview to production data.

SITE_URL=https://rolandodelcarmen.com
RESEND_API_KEY=

# A bare From address receives the display name Rolando Del Carmen.
# An explicit Name <address> is preserved. MAIL_FROM is an optional shared fallback.
CONTACT_EMAIL_FROM=no-reply@rolandodelcarmen.com
NEWSLETTER_EMAIL_FROM=no-reply@rolandodelcarmen.com
# MAIL_FROM="Rolando Del Carmen <no-reply@rolandodelcarmen.com>"

CONTACT_EMAIL_TO=errezetaerre@gmail.com
MAIL_REPLY_TO=errezetaerre@gmail.com

# Preserve the existing del-carmen-contact database and its records.
# Coordinate credential rotation with all consumers and a new approved deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# VERCEL_ENV and VERCEL_URL are platform-provided. Preview mail links stay there.
# Retire legacy NEXT_PUBLIC_SITE_URL only after checking every environment scope.
# The future studio@ mailbox has no receiving configuration and is not used here.
